# ==============================================================================
# Groq API Configuration for "Am I Exam-Ready?" (A1 German Readiness Check)
# ==============================================================================
# 1. Sign up for a free Groq account and create an API key at:
#    https://console.groq.com/keys
# 2. Copy this file to '.env':
#    copy .env.example .env
# 3. Paste your Groq API key below:

GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Default Groq Model
# Options:
# - qwen/qwen3.8-27b          (Fast, high-quality multilingual German tutoring)
# - openai/gpt-oss-120b       (High reasoning scale)
# - llama-3.3-70b-versatile   (Meta Llama 3.3)
GROQ_MODEL=qwen/qwen3.8-27b
